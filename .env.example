# =====================================================================
# Kage Configuration & Environment Variables
# Cost: Rs 0 (All providers & tools must remain within free tiers)
# =====================================================================

# Telegram Bot Credentials (Get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Security Allowlist: Comma-separated list of allowed Telegram user IDs
# Bot will ignore/drop any requests from IDs not listed here.
# Get your ID from @userinfobot or @raw_data_bot on Telegram
TELEGRAM_ALLOWED_USER_IDS=123456789

# Timezone (Used for resolving 'tomorrow', '7:30 AM', etc.)
TIMEZONE=Asia/Kolkata

# Primary LLM Provider: 'gemini' | 'groq' | 'ollama'
LLM_PROVIDER=gemini

# Google Gemini API Key (Free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Free tier from GroqCloud: https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama Base URL (Optional local free LLM fallback)
OLLAMA_BASE_URL=http://localhost:11434

# SQLite Database Paths
DATABASE_PATH=data/kage.sqlite
JOBS_DATABASE_PATH=data/jobs.sqlite

# Google OAuth (Phase 3: Calendar & Gmail read-only)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# GitHub Personal Access Token (Phase 3: Classic PAT for notifications read-only)
GITHUB_TOKEN=
